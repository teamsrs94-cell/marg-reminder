# --- Core ---
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./marg_reminder.db
# Admin login; also receives an email alert if automatic reminders fail
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
# Name shown on default-sender messages, e.g. SRS Engineering (editable later in Settings)
BRAND_NAME=Marg Reminder
# Public address (used in password-reset emails). Also editable in Settings.
APP_URL=
TIMEZONE=Asia/Kolkata
DEFAULT_COUNTRY_CODE=91
# https cookies only (set true behind HTTPS)
COOKIE_SECURE=true

# --- Reminder schedule ---
# Days relative to expiry. Negative = overdue. Runs once a day after REMINDER_HOUR (local time).
REMINDER_DAYS=30,15,7,1,0,-7
REMINDER_HOUR=10
ENABLE_SCHEDULER=true

# --- Email (SMTP) ---
# Gmail: use an App Password (Google Account > Security > 2-Step Verification > App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourname@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=yourname@gmail.com

# --- WhatsApp (Meta Cloud API). Template body takes 5 params:
# {{1}} customer, {{2}} product, {{3}} expiry date, {{4}} timing text, {{5}} distributor
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=marg_renewal_reminder
WHATSAPP_LANG=en

# --- SMS via Twilio (SMS_PROVIDER = twilio | msg91). TWILIO_FROM = your Twilio number or sender ID, e.g. +1415... ---
SMS_PROVIDER=twilio
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=
