# --- Core ---
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./marg_reminder.db
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
TIMEZONE=Asia/Kolkata
DEFAULT_COUNTRY_CODE=91
# https cookies only (set true behind HTTPS)
COOKIE_SECURE=false

# --- Reminder schedule ---
# Days relative to expiry. Negative = overdue. Runs once a day after REMINDER_HOUR (local time).
REMINDER_DAYS=30,15,7,1,0,-7
REMINDER_HOUR=10
ENABLE_SCHEDULER=true

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=renewals@example.com

# --- WhatsApp (Meta Cloud API). Template body takes 5 params:
# {{1}} customer, {{2}} product, {{3}} expiry date, {{4}} timing text, {{5}} distributor
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=marg_renewal_reminder
WHATSAPP_LANG=en

# --- SMS: SMS_PROVIDER = twilio | msg91 ---
SMS_PROVIDER=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=
